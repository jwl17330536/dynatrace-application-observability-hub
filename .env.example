# Copy to .env.local and fill with tenant-specific values.
# Never commit local secret files.

DT_ENVIRONMENT_URL=https://your-tenant.live.dynatrace.com
DT_PLATFORM_TOKEN=REPLACE_WITH_PLATFORM_TOKEN
DT_API_TOKEN=REPLACE_WITH_ENV_API_TOKEN

# Optional CMDB sync inputs
CMDB_BASE_URL=https://your-cmdb-host.example.com
CMDB_USERNAME=REPLACE_WITH_CMDB_USERNAME
CMDB_PASSWORD=REPLACE_WITH_CMDB_PASSWORD
